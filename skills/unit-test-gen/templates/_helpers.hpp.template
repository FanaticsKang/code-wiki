// =============================================================================
// 浮点近似断言（处理 NaN/Inf）
// =============================================================================

inline void assertApprox(double actual, double expected, double tol = 1e-9) {
    // NaN 处理
    if (std::isnan(actual) && std::isnan(expected)) {
        return;
    }
    if (std::isnan(actual) || std::isnan(expected)) {
        FAIL() << "NaN mismatch: actual=" << actual
               << ", expected=" << expected;
    }

    // Inf 处理
    if (std::isinf(actual) || std::isinf(expected)) {
        if (actual == expected) {
            return;  // 同号 Inf
        }
        FAIL() << "Inf mismatch: actual=" << actual
               << ", expected=" << expected;
    }

    // 常规比较
    double diff = std::abs(actual - expected);
    if (diff <= tol) {
        return;
    }
    if (expected != 0 && diff / std::abs(expected) <= tol) {
        return;
    }
    FAIL() << "Float assertion failed: actual=" << actual
           << ", expected=" << expected
           << ", tol=" << tol;
}


// =============================================================================
// 确定性验证（纯函数）
// =============================================================================

template <typename Func, typename... Args>
void assertDeterministic(Func func, int runs, Args&&... args) {
    auto first = func(std::forward<Args>(args)...);
    for (int i = 1; i < runs; ++i) {
        auto other = func(std::forward<Args>(args)...);
        if (other != first) {
            FAIL() << "Determinism assertion failed: run " << (i + 1)
                   << " differs from run 1";
        }
    }
}


