// 生成大规模向量
template <typename T>
std::vector<T> generateLargeVector(int size, T (*factory)(int) = nullptr) {
    std::vector<T> result;
    result.reserve(size);
    for (int i = 0; i < size; ++i) {
        if (factory) {
            result.push_back(factory(i));
        } else {
            result.push_back(static_cast<T>(i));
        }
    }
    return result;
}

// 生成大规模字符串
inline std::string generateLargeString(int size) {
    return std::string(size, 'a');
}

// 可扩展性断言：验证函数处理大规模输入的时间增长在合理范围内
template <typename Func, typename Input>
double assertScalability(Func func, const Input& small_input,
                          const Input& large_input, double max_ratio = 100.0) {
    // 预热
    func(small_input);

    auto start = std::chrono::high_resolution_clock::now();
    func(small_input);
    auto small_time = std::chrono::duration<double>(
        std::chrono::high_resolution_clock::now() - start).count();

    start = std::chrono::high_resolution_clock::now();
    func(large_input);
    auto large_time = std::chrono::duration<double>(
        std::chrono::high_resolution_clock::now() - start).count();

    double ratio = (small_time > 0) ? (large_time / small_time)
                                    : std::numeric_limits<double>::infinity();

    if (ratio > max_ratio) {
        FAIL() << "Scalability assertion failed: large input took "
               << ratio << "x of small input time (threshold " << max_ratio
               << "). Small: " << small_time << "s, Large: " << large_time << "s";
    }

    return ratio;
}


