def get_boundaries(type_name: str) -> list:
    """
    按类型名取边界值列表。

    >>> get_boundaries("int")
    [0, -1, 1, ...]
    """
    return BOUNDARY_VALUES.get(type_name.lower(), [])


# =============================================================================
# 异步函数包装
# =============================================================================

def call_async(coro):
    """
    同步调用异步函数。用法：

        result = call_async(my_async_func(arg1, arg2))

    避免对 pytest-asyncio 的依赖。适合简单的异步测试。
    """
    try:
        loop = asyncio.get_event_loop()
        if loop.is_running():
            # 已在事件循环内（罕见），创建新 loop
            new_loop = asyncio.new_event_loop()
            try:
                return new_loop.run_until_complete(coro)
            finally:
                new_loop.close()
        return loop.run_until_complete(coro)
    except RuntimeError:
        # 没有现成 loop
        return asyncio.run(coro)


# =============================================================================
# 浮点断言（处理 NaN/Inf）
# =============================================================================

def assert_approx(actual: float, expected: float, tol: float = 1e-9) -> None:
    """
    浮点近似断言，正确处理 NaN 和 Inf。

    - 两个 NaN 视为相等
    - 同号 Inf 视为相等
    - 其他情况用相对容差 + 绝对容差比较
    """
    # NaN 处理
    if math.isnan(actual) and math.isnan(expected):
        return
    if math.isnan(actual) or math.isnan(expected):
        raise AssertionError(f"NaN mismatch: actual={actual!r}, expected={expected!r}")

    # Inf 处理
    if math.isinf(actual) or math.isinf(expected):
        if actual == expected:  # 同号 Inf
            return
        raise AssertionError(f"Inf mismatch: actual={actual!r}, expected={expected!r}")

    # 常规比较
    diff = abs(actual - expected)
    if diff <= tol:
        return
    if expected != 0 and diff / abs(expected) <= tol:
        return
    raise AssertionError(
        f"浮点断言失败: actual={actual!r}, expected={expected!r}, tol={tol}"
    )


# =============================================================================
# 确定性验证（纯函数）
# =============================================================================

def assert_deterministic(func: Callable, *args, runs: int = 3, **kwargs) -> None:
    """
    确定性验证：同样输入调用 func 多次，结果必须完全一致。

        assert_deterministic(format_id, "user", 42)
    """
    first = func(*args, **kwargs)
    for i in range(runs - 1):
        other = func(*args, **kwargs)
        if other != first:
            raise AssertionError(
                f"确定性断言失败: 第 {i+2} 次调用结果与第 1 次不一致。\n"
                f"  第 1 次: {first!r}\n"
                f"  第 {i+2} 次: {other!r}"
            )


# =============================================================================
# Mock 工具
# =============================================================================

def mock_file(content: str | bytes = "") -> MagicMock:
    """
    构造一个模拟文件对象，支持 read/write/close 和 context manager 协议。

        with patch("builtins.open", return_value=mock_file("hello")):
            ...
    """
    m = MagicMock()
    if isinstance(content, str):
        m.read.return_value = content
        m.readlines.return_value = content.splitlines(keepends=True)
    else:
        m.read.return_value = content
    m.__enter__ = MagicMock(return_value=m)
    m.__exit__ = MagicMock(return_value=False)
    return m


def mock_response(
    json_data: Any = None,
    status_code: int = 200,
    text: str = "",
) -> MagicMock:
    """
    构造一个模拟 HTTP 响应对象，适用于 requests/httpx 等。

        with patch("requests.get", return_value=mock_response(json_data={"id": 1})):
            ...
    """
    m = MagicMock()
    m.status_code = status_code
    m.ok = 200 <= status_code < 300
    m.json.return_value = json_data if json_data is not None else {}
    m.text = text
    m.content = text.encode() if text else b""
    m.raise_for_status = MagicMock()
    if status_code >= 400:
        from urllib.error import HTTPError
        m.raise_for_status.side_effect = HTTPError(
            "", status_code, f"HTTP {status_code}", {}, None
        )
    return m


# =============================================================================
# 性能测试工具
# =============================================================================

PERFORMANCE_CONFIG: dict[str, dict] = {
    "small": {"size": 100},
    "medium": {"size": 10000},
    "large": {"size": 100000},
}


def generate_large_input(
    type_name: str,
    size: int = 10000,
    *,
    element_factory: Callable | None = None,
) -> Any:
    """
    生成指定类型和大小的大规模测试输入。

        large_list = generate_large_input("list", size=50000)
        large_str = generate_large_input("str", size=100000)
    """
    factory = element_factory or (lambda i: i)
    if type_name == "list":
        return [factory(i) for i in range(size)]
    elif type_name == "dict":
        return {i: factory(i) for i in range(size)}
    elif type_name == "str":
        return "a" * size
    elif type_name == "bytes":
        return b"\x00" * size
    elif type_name == "set":
        return {factory(i) for i in range(size)}
    else:
        return [factory(i) for i in range(size)]


def assert_scalability(
    func: Callable,
    small_input: Any,
    large_input: Any,
    *,
    max_ratio: float = 100.0,
) -> float:
    """
    可扩展性断言：验证函数处理大规模输入的时间增长在合理范围内。

    返回时间比率 (large_time / small_time)。
    不做硬性阈值断言（CI 环境差异大），只记录时间并验证非指数增长。

        ratio = assert_scalability(sort_data, small_list, large_list)
    """
    import time

    # 预热
    func(small_input)

    start = time.perf_counter()
    func(small_input)
    small_time = time.perf_counter() - start

    start = time.perf_counter()
    func(large_input)
    large_time = time.perf_counter() - start

    ratio = large_time / small_time if small_time > 0 else float("inf")

    if ratio > max_ratio:
        raise AssertionError(
            f"可扩展性断言失败: 大输入耗时是小输入的 {ratio:.1f} 倍 "
            f"(阈值 {max_ratio})。小输入 {small_time:.6f}s，大输入 {large_time:.6f}s"
        )

    return ratio


